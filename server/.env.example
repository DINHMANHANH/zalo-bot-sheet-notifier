# Server
PORT=3000
NODE_ENV=development

# Zalo Bot
# Lấy Bot Token trong Zalo Bot Manager / tin nhắn bot gửi cho chủ bot
ZALO_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
# Tự đặt chuỗi bí mật 8-256 ký tự. Dùng khi setWebhook và khi Zalo gọi webhook về server.
ZALO_WEBHOOK_SECRET=MY_ZALO_BOT_SECRET_2026
# URL server sau khi deploy HTTPS, ví dụ Render: https://ten-server.onrender.com
PUBLIC_BASE_URL=https://your-server.onrender.com

# Token nội bộ để Apps Script gọi server, tự đặt chuỗi khó đoán
INTERNAL_API_TOKEN=CHANGE_ME_INTERNAL_TOKEN_2026

# Google Sheet
GOOGLE_SPREADSHEET_ID=PASTE_SPREADSHEET_ID_HERE
